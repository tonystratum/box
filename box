#!/bin/zsh
# box: run Claude Code in isolated apple/container VMs. See DESIGN.md.
setopt err_return pipe_fail extended_glob

IMG=box:latest
DIR=${0:A:h}
# Secrets/identity are passed by name only: `container exec -e NAME` copies the
# value from our environment and skips unset names, so values never hit argv or disk.
# load_tokens appends each token the box was given.
ENVS=(-e GIT_AUTHOR_NAME -e GIT_AUTHOR_EMAIL -e GIT_COMMITTER_NAME -e GIT_COMMITTER_EMAIL)

die() { print -u2 -- "error: $*"; exit 1 }

# owner/repo from any GitHub form: owner/repo, https://github.com/owner/repo(.git), git@github.com:owner/repo.git
repo_of() {
  local u=${1%/}; u=${u%.git}
  u=${u#git@github.com:}; u=${u#http(s|)://}; u=${u#www.}; u=${u#github.com/}
  [[ $u == [A-Za-z0-9_.-]##/[A-Za-z0-9_.-]## ]] || die "not a GitHub repo: $1"
  print -r -- $u
}

randname() {
  local -a a=(brisk calm dusty eager fuzzy gentle hollow icy jolly keen lucky mellow nimble odd plain quiet
              rusty shy snowy tidy vivid warm witty young zesty amber bold crisp dry fresh grand humble)
  local -a b=(otter falcon badger heron lynx marmot newt owl panda quail raven seal tapir viper walrus yak
              bison crane dingo egret ferret gecko ibis koala lemur moose narwhal ocelot puffin robin stoat wren)
  local -a c=(lamp anchor bridge candle drum engine fern glacier harbor island jar kettle ladder mirror needle orbit
              pebble quilt river saddle tower umbrella valley wagon yarn zipper beacon canyon delta ember forge grove)
  print -r -- ${a[RANDOM%32+1]}-${b[RANDOM%32+1]}-${c[RANDOM%32+1]}
}

# Token NAME is prefix[:label]. ':' separates because POSIX command names never contain it, while '-' and '.' are common.
tok_name() { [[ $1 == [a-z0-9][a-z0-9_.-]#(|:[a-z0-9][a-z0-9_.-]#) ]] || die "bad token name '$1' (prefix[:label], lowercase letters, digits, _ . -)" }
# Env var for token NAME: VAR if given, else picked by the prefix.
tok_var() {
  tok_name $1
  if [[ -n $2 ]]; then
    [[ $2 == [A-Z_][A-Z0-9_]# ]] || die "bad env var '$2'"
    print -r -- $2; return 0
  fi
  case ${1%%:*} in
    gh)     print GH_TOKEN ;;
    claude) print CLAUDE_CODE_OAUTH_TOKEN ;;
    *)      die "unknown prefix '${1%%:*}': known: gh, claude; or pass --env VAR (not guaranteed to work)" ;;
  esac
}
# Keychain path of a token's value: box SRC, where SRC is local:NAME or shared:NAME.
tok_path() { [[ $2 == local:* ]] && print -r -- local/$1/${2#local:} || print -r -- shared/${2#shared:} }

state() { container ls -a --format json | jq -r --arg id box-$1 '.[] | select(.configuration.id==$id) | .status.state' }
need()  { [[ -n $(state $1) ]] || die "no such project '$1' (see: box ls)" }
up()    { need $1; [[ $(state $1) == running ]] || container start box-$1 >/dev/null }
x()     { local n=$1; shift; container exec "${ENVS[@]}" -u claude -w /work/$n box-$n "$@" }  # quiet exec in repo dir

# Keychain items, all under box/: local/BOX/NAME and shared/NAME hold values;
# grant/BOX/VAR holds "local:NAME" or "shared:NAME" (which token BOX gets as VAR).
kc_get() { security find-generic-password -s "box/$1" -w 2>/dev/null }
kc_set() { print "Paste $2 (input hidden, asked twice):"; security add-generic-password -U -a "$USER" -s "box/$1" -w }
kc_put() { security add-generic-password -U -a "$USER" -s "box/$1" -w "$2" }  # non-secret values only: argv is visible to ps
kc_del() { security delete-generic-password -s "box/$1" &>/dev/null || true }
kc_ls()  {  # item names under box/PREFIX; dump-keychain without -d prints no values
  local p=${1//./[.]}
  security dump-keychain 2>/dev/null | sed -nE "s#.*\"svce\"<blob>=\"box/$p([^\"]+)\".*#\\1#p" | sort -u
}
grants() {  # box: "VAR SRC" per line
  local v s
  for v in ${(f)"$(kc_ls grant/$1/)"}; do s=$(kc_get grant/$1/$v) && print -r -- "$v $s"; done
  return 0
}
replace_hint() { [[ $2 == local:* ]] && print -r -- "box token replace $1 ${2#*:}" || print -r -- "box token replace --shared ${2#*:}" }

load_tokens() {  # box: export each token it was given, and pass it by name
  local v s val
  for v s in $(grants $1); do
    val=$(kc_get $(tok_path $1 $s)) || { print -u2 "token ${s#*:} ($v) is missing from the Keychain: box token rm $1 ${s#*:}"; continue }
    export "$v=$val"; ENVS+=(-e $v)
  done
}
load_identity() {
  # Skip if Xcode CLT is missing: the /usr/bin/git stub would pop an installer dialog.
  xcode-select -p &>/dev/null || return 0
  GIT_AUTHOR_NAME=$(git config --global user.name) GIT_AUTHOR_EMAIL=$(git config --global user.email) || :
  export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
}

# Create + start a container with its box-NAME volume at /work.
create() {
  local n=$1
  [[ -z $(state $n) ]] || die "project '$n' exists; use --name"
  container image inspect $IMG &>/dev/null || die "no image: run 'box build'"
  container create --name box-$n --init -c 8 -m 16G -l box=1 -v box-$n:/work $IMG sleep infinity >/dev/null
  container start box-$n >/dev/null
  container exec -u root box-$n sh -c "mkdir -p /work/$n && chown -R claude:claude /work" \
    || { delete $n; die "setup of $n failed; nothing was kept"; }
}

clone() {  # name owner/repo
  container exec "${ENVS[@]}" -u claude -w /work box-$1 git clone -q https://github.com/$2.git $1 \
    || { delete $1; die "clone failed: check that $2 exists, and pass --clone-token for a private repo"; }
}

# Hard-coded exit guard: true only if the work tree is clean and every commit is on a remote.
pushed() {
  [[ -z $(x $1 git status --porcelain) ]] && [[ -z $(x $1 git log --oneline --branches --not --remotes) ]]
}

session() {  # name [cmd...]: bash (or cmd) with the box's tokens and git identity
  local n=$1 g; shift
  (( $# )) || set -- bash -l
  up $n; load_tokens $n; load_identity
  # Check only a token the box was given; ENVS can also hold a --clone-token that was unset after the clone.
  if g=$(kc_get grant/$n/GH_TOKEN) && [[ $(x $n git remote get-url origin 2>/dev/null) == https://github.com/* ]]; then
    x $n git ls-remote -q origin &>/dev/null || print -u2 "warning: GitHub rejected GH_TOKEN (expired?): $(replace_hint $n $g)"
  fi
  # exec -t sets TERM=xterm (8 colors); the host's own TERM (e.g. xterm-ghostty) may have no terminfo in the box.
  TERM=xterm-256color container exec -it -e TERM "${ENVS[@]}" -u claude -w /work/$n box-$n "$@"
}

delete() {  # name: container, volume, and the box's own tokens and grants
  container delete -f box-$1 >/dev/null; container volume delete box-$1 &>/dev/null || true
  forget $1
}
forget() {  # name: the box's own tokens and grants, so a reused name never inherits them
  local k
  for k in ${(f)"$(kc_ls local/$1/)"}; do kc_del local/$1/$k; done
  for k in ${(f)"$(kc_ls grant/$1/)"}; do kc_del grant/$1/$k; done
}

reap() {  # name: on session exit, delete only if pushed(), else say how to resume
  if pushed $1; then delete $1; print "clean, deleted $1"
  else print "unpushed work: kept $1\n  resume:  box run $1\n  discard: box rm --force $1"; fi
}

token() {  # verb args...
  local verb=$1 shared env box name var src cur g; (( $# )) && shift
  local -a args used; local -A on
  while (( $# )); do case $1 in
    --shared) shared=1; shift ;; --env) env=${2:?--env needs VAR}; shift 2 ;; -*) die "unknown arg: $1" ;; *) args+=($1); shift ;;
  esac; done
  case $verb in
    add)
      if [[ -n $shared ]] && (( $#args == 1 )); then  # store a shared token without giving it to a box
        name=$args[1]; tok_name $name
        [[ -z $env ]] || die "--env goes with a box: box token add BOX --shared --env $env $name"
        kc_get shared/$name >/dev/null && { print "shared $name is already stored (new value: box token replace --shared $name)"; return 0 }
        kc_set shared/$name "the value for $name" || die "token not stored"
        print "stored shared $name; give it to a box with: box token add BOX --shared $name"
        return 0
      fi
      (( $#args == 2 )) || die "usage: box token add BOX [--shared] [--env VAR] NAME | box token add --shared NAME"
      box=$args[1] name=$args[2]; need $box
      var=$(tok_var $name $env) || exit 1
      src=${${shared:+shared}:-local}:$name
      cur=$(kc_get grant/$box/$var) || cur=
      [[ $cur == $src ]] && { print "$box already has $name"; return 0 }
      [[ -n $shared && $cur == local:* ]] && die "$box has box-only ${cur#*:} as $var, which wins over shared: box token rm $box ${cur#*:} first"
      kc_get $(tok_path $box $src) >/dev/null || kc_set $(tok_path $box $src) "the value for $name" || die "token not stored"
      kc_put grant/$box/$var $src
      # A replaced box-only token is dropped unless another var still uses it.
      [[ $cur == local:* ]] && [[ " $(grants $box) " != *" $cur"[[:space:]]* ]] && kc_del local/$box/${cur#*:}
      print "added $name to $box as $var${cur:+ (replaces ${cur#*:})}; takes effect at the next 'box run $box'" ;;
    rm)
      if [[ -n $shared ]]; then
        (( $#args == 1 )) || die "usage: box token rm --shared NAME"
        name=$args[1]; kc_get shared/$name >/dev/null || die "no shared token $name (see: box token ls)"
        for g in ${(f)"$(kc_ls grant/)"}; do
          [[ $(kc_get grant/$g) == shared:$name ]] && { kc_del grant/$g; used+=(${g%%/*}) }
        done
        kc_del shared/$name; used=(${(u)used})
        print "deleted shared $name; removed from: ${${(j:, :)used}:-no boxes}"
      else
        (( $#args == 2 )) || die "usage: box token rm BOX NAME | box token rm --shared NAME"
        box=$args[1] name=$args[2]
        for var src in $(grants $box); do
          [[ ${src#*:} == $name ]] || continue
          kc_del grant/$box/$var; used+=($var)
          [[ $src == local:* ]] && kc_del local/$box/$name
        done
        (( $#used )) || die "$box has no $name (see: box token ls $box)"
        print "removed $name from $box"
      fi ;;
    replace)
      if [[ -n $shared ]]; then
        (( $#args == 1 )) || die "usage: box token replace --shared NAME"
        name=$args[1]; kc_get shared/$name >/dev/null || die "no shared token $name: box token add BOX --shared $name"
        kc_set shared/$name "the new value for $name" || die "token not stored"
        print "replaced shared $name; boxes get it at their next 'box run'"
      else
        (( $#args == 2 )) || die "usage: box token replace BOX NAME | box token replace --shared NAME"
        box=$args[1] name=$args[2]
        if ! kc_get local/$box/$name >/dev/null; then
          [[ " $(grants $box) " == *" shared:$name"[[:space:]]* ]] && die "$name is shared: box token replace --shared $name"
          die "$box has no $name: box token add $box $name"
        fi
        kc_set local/$box/$name "the new value for $name" || die "token not stored"
        print "replaced $name on $box; takes effect at the next 'box run $box'"
      fi ;;
    ls)
      if (( $#args )); then
        for var src in $(grants $args[1]); do print -r -- "$var ${src#*:} ${${src%%:*}/local/box-only}"; done | column -t
      else
        for g in ${(f)"$(kc_ls grant/)"}; do
          src=$(kc_get grant/$g) || continue
          [[ $src == shared:* ]] && on[${src#*:}]=${on[${src#*:}]:+${on[${src#*:}]},}${g%%/*}
        done
        for name in ${(f)"$(kc_ls shared/)"}; do print -r -- "$name ${on[$name]:--}"; done | column -t
      fi ;;
    *) die "usage: box token add|rm|replace|ls (see: box help)" ;;
  esac
}

usage() {
  cat <<'EOF'
usage: box <command>
  build                                       build the sandbox image (Containerfile + claude-home/)
  new [--name N] [--clone REPO [--clone-token T]] [--token T]... [--shared-token T]...
                                              new project (empty, or a clone), then run; deleted on exit unless work is unpushed
                                              --token: box-only token (asks for it); --shared-token: shared one; gh and claude prefixes only
  claude [same options as new]                same as new, but gives the box the shared claude token and starts claude
  claude login                                store the shared Claude token
  run NAME                                    bash in the project with its tokens loaded
  token add BOX [--shared] [--env VAR] T      give BOX token T (asks for the value if not stored); takes effect at the next run
  token add --shared T                        store shared token T without giving it to a box
  token rm BOX T | token rm --shared T        take T from BOX | delete shared T and take it from every box
  token replace BOX T | replace --shared T    enter a new value
  token ls [BOX]                              BOX's tokens | shared tokens and the boxes that have them
  ls | stop NAME | rm [--force] NAME          rm also deletes the box's own tokens
Tokens: T is prefix[:label], e.g. gh:push. The prefix picks the env var: gh -> GH_TOKEN,
  claude -> CLAUDE_CODE_OAUTH_TOKEN. Any other prefix needs --env VAR, with no guarantee the tool reads it.
  A token belongs to one box unless --shared. If a box-only and a shared token map to the same var, box-only wins.
  --clone-token T uses shared token T for the clone only; the box doesn't keep it.
REPO: owner/repo, https://github.com/owner/repo or git@github.com:owner/repo.git
EOF
}

main() {
  local cmd=${1:-help}; (( $# )) && shift
  case $cmd in
    build) container build -t $IMG -f $DIR/Containerfile $DIR ;;
    new|claude)
      if [[ $cmd == claude && $1 == login ]]; then
        print "Approve in the browser, then copy the printed token."
        container run --rm -it $IMG claude setup-token
        kc_set shared/claude "the Claude token" || die "token not stored"
        return 0
      fi
      local name repo ctok cvar v t
      local -a run toks stoks
      while (( $# )); do case $1 in
        --name) name=$2; shift 2 ;; --clone) repo=$(repo_of $2) || exit 1; shift 2 ;;
        --clone-token) ctok=${2:?--clone-token needs a token name}; shift 2 ;;
        --token) toks+=(${2:?--token needs a token name}); shift 2 ;;
        --shared-token) stoks+=(${2:?--shared-token needs a token name}); shift 2 ;;
        *) die "unknown arg: $1" ;;
      esac; done
      [[ -n $ctok && -z $repo ]] && die "--clone-token needs --clone"
      if [[ $cmd == claude ]]; then
        kc_get shared/claude >/dev/null || die "no Claude token: run 'box claude login'"
        run=(claude --dangerously-skip-permissions)
      fi
      [[ -n $repo ]] && : ${name:=${repo/\//-}}
      [[ -z $name ]] && until name=$(randname); [[ -z $(state $name) ]]; do :; done
      name=${name:l}
      [[ $name == [a-z0-9][a-z0-9_.-]# ]] || die "bad name '$name' (letters, digits, - _ .)"
      # Tokens: check every name and ask for every value before anything is created.
      [[ -z $(state $name) ]] || die "project '$name' exists; use --name"
      forget $name  # leftovers from an earlier box of this name (e.g. an interrupted new)
      for t in $toks $stoks; do
        tok_name $t
        v=$(tok_var $t 2>/dev/null) || die "--token $t: at creation only the gh and claude prefixes work; for others, after creating: box token add $name --env VAR $t"
      done
      for t in $stoks; do kc_get shared/$t >/dev/null || kc_set shared/$t "the shared token $t" || die "token not stored"; done
      for t in $toks; do kc_set local/$name/$t "the value for $t (only for $name)" || { forget $name; die "token not stored; nothing was created"; }; done
      if [[ -n $ctok ]]; then
        cvar=$(tok_var $ctok) || exit 1
        kc_get shared/$ctok >/dev/null || kc_set shared/$ctok "the shared token $ctok" || die "token not stored"
        v=$(kc_get shared/$ctok) || die "token $ctok not readable"
        export "$cvar=$v"; ENVS+=(-e $cvar)
      fi
      create $name
      if [[ -n $repo ]]; then clone $name $repo; else x $name git init -q -b main; fi
      [[ -n $cvar ]] && unset $cvar  # clone only: exec -e skips unset names, so the box never sees it
      [[ $cmd == claude ]] && kc_put grant/$name/CLAUDE_CODE_OAUTH_TOKEN shared:claude
      # Shared first, so a box-only token for the same env var replaces it (box-only wins).
      for t in $stoks; do token add $name --shared $t >/dev/null; done
      for t in $toks; do token add $name $t >/dev/null; done
      print "created $name"; (( $#toks + $#stoks )) && token ls $name
      session $name $run || true
      reap $name ;;
    run)   [[ -n $1 ]] || die "usage: box run NAME"; session $1 ;;
    token) token "$@" ;;
    ls)    container ls -a --format json | jq -r '.[] | select(.configuration.id|startswith("box-"))
             | "\(.configuration.id|ltrimstr("box-"))\t\(.status.state)"' | column -t ;;
    stop)  need ${1:?usage: box stop NAME}; container stop box-$1 >/dev/null ;;
    rm)
      local force; [[ $1 == --force ]] && { force=1; shift; }
      local n=${1:?usage: box rm [--force] NAME}
      [[ -n $force ]] || { up $n; pushed $n || die "$n has uncommitted or unpushed work; use --force"; }
      delete $n; print "deleted $n" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

# Run only when executed, so tests can source the functions.
if [[ $ZSH_EVAL_CONTEXT == toplevel ]]; then main "$@"; fi
